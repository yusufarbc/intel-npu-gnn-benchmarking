## PROJECT: npu-gnn-opt-benchmarking
## Clean and minimal gitignore

# Python
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg-info/
*.egg
dist/
.eggs/
build/

# Virtual environments
.venv/
venv/
env/
.pixi
.pdm-python
.pdm-build/
