# Environment
.env
.envrc

# IDE
.vscode/
.idea/
*.swp
*~

# Jupyter
.ipynb_checkpoints/

# Dataset snapshots
data/ogbn_*/

# Local documentation notes and review files (not published with the repository)
docs/
.committee-conditions
scratch/

# ONNX models (large binary files — regenerate with: python analysis/model_prep.py)
models/*.onnx
models/*.onnx.data
models/*.onnx.failed
results/scaling_sweep/models/**/*.onnx
results/scaling_sweep/models/**/*.onnx.data

# Benchmark runtime artifacts
*.etl
results/**/*.log
results/**/progress.log
results/scaling_sweep/runs/
results/density_sweep/runs/
results/**/run_*/performance_comparison.png

# Reference PDFs (copyright — cite via references.bib)
paper/references/*.pdf
# paper/references/*.md  ← .md files are our own extracted notes, tracked intentionally

# Large standalone PDFs
*.pdf
!paper/paper.pdf
!showcase/poster-export.pdf
!paper/figures/*.pdf
!results/figures/*.pdf

# Testing
htmlcov/
.pytest_cache/
.coverage
.coverage.*

