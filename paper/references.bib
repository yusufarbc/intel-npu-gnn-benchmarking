author = {Xu, Daliang and Zhang, Hao and Yang, Liming and Liu, Ruiqi and Huang, Gang and Xu, Mengwei and Liu, Xuanzhe},
title = {Fast On-device LLM Inference with NPUs},
year = {2025},
